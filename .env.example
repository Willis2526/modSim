# Copy to .env and adjust as needed, then `docker compose up -d`.

# Web UI / API port (host:container mapping uses this on the host side only).
WEB_PORT=8000

# Range of Modbus TCP ports published to the host, e.g. "502-520". Covers the
# default server 0 (502) plus headroom for servers added later via the web
# UI/API. A new server's port must fall inside this range to be reachable
# from outside the container — widen it here and run
# `docker compose up -d` to apply (no rebuild needed).
MODBUS_PORT_RANGE=502-520
